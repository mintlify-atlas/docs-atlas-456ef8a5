  "keyFeatures": [
    "JWT authentication with automatic token refresh and session persistence via Redux Persist",
    "Account dashboard showing current balance, due date, meter info, and service addresses",
    "Bill history with date range filtering and CSV export",
    "Multi-method payment processing through a secure iframe micro-frontend",
    "Real-time outage status monitoring with outage reporting form",
    "Meter reading submission and service request ticketing",
    "Multi-step new service activation wizard with address autocomplete",
    "AI-powered support chat widget with support ticket management",
    "Micro-frontend architecture using Vite Module Federation"
  ],
  "publicApiSurface": [
    "POST /auth/login",
    "POST /auth/refresh",
    "GET /utility/electricity/account",
    "GET /utility/electricity/bills",
    "POST /utility/electricity/meter-reading",
