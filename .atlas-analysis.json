{
  "projectType": "saas",
  "projectName": "Smart CX Utility Portal",
  "projectDescription": "A full-stack customer experience portal for utility companies that lets end-users manage electricity accounts, view and pay bills, report outages, submit meter readings, and get AI-powered support.",
